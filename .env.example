# Video Studio / Pendrive-Recovery environment template
# Copy to .env and adjust. All keys are optional; defaults shown.

# Loopback port for the backend (the server always binds 127.0.0.1).
PORT=8080

# Default image/output folder. Must be inside RECOVERY_ROOTS.
DEFAULT_OUTPUT_DIR=C:\PendriveRecovery

# Semicolon-separated allowlists. The server rejects device/upload/output paths
# outside these roots, so add any extra drive or folder you intend to use.
RECOVERY_ROOTS=C:\PendriveRecovery;C:\Recovery;D:\PendriveRecovery;D:\Recovery;/mnt/c/PendriveRecovery;/mnt/c/Recovery;/mnt/d/PendriveRecovery;/mnt/d/Recovery
# Readable media inputs for Cut/Join/Transcode (workspace + user folders are added automatically).
MEDIA_ROOTS=C:\Users\admin\Videos;C:\Users\admin\Downloads

# WSL distribution used to run ddrescue / PhotoRec / TestDisk.
WSL_DISTRO_NAME=Ubuntu

# PhotoRec output folder name, created next to the image (holds carved.* folders).
PHOTOREC_CARVE_DIR=carved

# HandBrake transcoding.
HANDBRAKE_CQ=18
HANDBRAKE_ENCODER=nvenc_h265_10bit

# DEBUG / INFO / WARNING / ERROR. Logs rotate at 5 MB x 5.
LOG_LEVEL=INFO

# Optional: override where the token, logs and runtime state live.
# Defaults to <workspace>/.runtime, or %LOCALAPPDATA%\VideoStudio for the packaged exe.
# VS_RUNTIME_DIR=C:\Users\admin\AppData\Local\VideoStudio

# Optional: override the SQLite job store (snapshots + replayable events).
# Defaults to <VS_RUNTIME_DIR>\jobs.db.
# VS_JOBS_DB=C:\Users\admin\AppData\Local\VideoStudio\jobs.db
